graph Roteamento {
    graph [layout=neato, bgcolor="transparent", overlap=false, outputorder=edgesfirst, pad=0.3];
    node [shape=circle, style=filled, fillcolor="#EAF1FA", color="#194A7A", penwidth=2, fontname="DejaVu Sans", fontsize=16, width=0.55];
    edge [color="#566778", penwidth=2.2, fontname="DejaVu Sans", fontsize=15, fontcolor="#17344F"];
    A [pos="50,150!"]; B [pos="220,260!"]; C [pos="220,40!"];
    D [pos="430,260!"]; E [pos="430,40!"];
    A -- B [label="4"];
    A -- C [label="2"];
    B -- C [label="1"];
    B -- D [label="5", color="#B55D33", penwidth=3];
    C -- D [label="8"];
    C -- E [label="10"];
    D -- E [label="2"];
}
